# Copy to .env and fill in. .env is gitignored.

# Where Unchore keeps its database, skills and task folders.
UNCHORE_HOME=~/unchore
PORT=4477

# Claude Code CLI used for every AI step (your subscription, your MCP servers).
CLAUDE_BIN=claude
# Model for extraction/plans (alias or full name). Empty = Claude Code default.
UNCHORE_MODEL=sonnet

# WhatsApp Business via uazapi (https://docs.uazapi.com)
UAZAPI_URL=https://YOUR-SUBDOMAIN.uazapi.com
UAZAPI_TOKEN=

# MCP server names as shown by `claude mcp list` (spaces/dots become underscores).
# The claude.ai Gmail connector shows up as "claude.ai Gmail" -> claude_ai_Gmail
GMAIL_MCP_SERVER=claude_ai_Gmail
SLACK_MCP_SERVER=claude_ai_Slack
CALENDAR_MCP_SERVER=claude_ai_Google_Calendar
